# Local secrets and handoff notes
INFO.md
*.local.*
*config-backup*.json
baekseok-config.json
# Writes the JSON above, with the same WiFi password and KMA key inline.
configure-baekseok-weather.ps1

# PlatformIO/build cache
.pio/
**/.pio/
.vscode/
*.elf
*.map

# Generated archives
dist/
README.remote.md

# Release directory: tracked in full. It holds the recovery firmware and the
# upload scripts as well as the release images, and reaching for those is the
# first step on unfamiliar hardware. Whitelisting only the tagged images left
# the recovery tooling untracked, so a fresh checkout did not carry it and its
# existence was not visible from the repository at all.
#
# The config backups matched near the top stay ignored: they carry the WiFi
# password and the KMA key. Nothing below re-includes them.

# Avoid duplicate generated releases inside firmware projects.
firmware/**/release/

# Sample photos handed over for the album feature. Personal images, and this
# repository is public.
album/

# Manufacturer firmware kept locally as a rollback image, not redistributed here.
release/stock/

# Python bytecode from the generators. Regenerated on every run.
__pycache__/
*.pyc
